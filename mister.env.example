# Per-CORE settings. Copy to mister.env (gitignored) only for values this core
# overrides; machine-wide settings live in ~/.mister-core.env (see the skill's
# mister-core.env.example). The environment overrides both.

# The MAME driver source this core follows, for extract_dips.py, extract_romstart.py
# and validate_mra.py.
#MAME_SRC=/path/to/mame/src/mame/<maker>/<driver>.cpp

# Override the machine's MiSTer or toolchain for this core only.
#MISTER_HOST=
#MISTER_USER=
#MISTER_PASSWORD=
#MAME_DIR=
#MAME_EXE=
#QUARTUS_BIN=
#MODELSIM_BIN=
