`verilator_config
// main.cpp writes the download image straight into the chip model
public_flat_rw -module "sdram_chip_model_wide" -var "mem"
// +bk= writes finalgdr's backup RAM
public_flat_rw -module "vh_dpram" -var "mem"
// the per-frame state line
public_flat_rw -module "e1_cpu" -var "G"
public_flat_rw -module "e1_cpu" -var "sr"
public_flat_rw -module "vh_main" -var "int2"
public_flat_rw -module "vh_cpumem" -var "st"
public_flat_rw -module "vh_cpumem" -var "bus_req"
public_flat_rw -module "vh_cpumem" -var "bus_wr"
public_flat_rw -module "vh_cpumem" -var "if_req"
public_flat_rw -module "vh_cpumem" -var "wb_valid"
public_flat_rw -module "e1_cpu" -var "state"
// +prof: the instruction in ST_EXEC, by class
public_flat_rw -module "e1_cpu" -var "op"
public_flat_rw -module "e1_cpu" -var "e1"
public_flat_rw -module "e1_cpu" -var "ipc"
public_flat_rw -module "vh_main" -var "io_rd"
public_flat_rw -module "vh_main" -var "io_wr"
public_flat_rw -module "vh_main" -var "io_port"
public_flat_rw -module "vh_main" -var "io_wd"
public_flat_rw -module "vh_main" -var "io_rdata"
public_flat_rw -module "vh_main" -var "g_bram"
// +swlog: sprite-list writes against the snapshot copy
public_flat_rw -module "vh_video" -var "vcnt"
public_flat_rw -module "vh_video" -var "spr_we"
public_flat_rw -module "vh_video" -var "cp_run"
public_flat_rw -module "vh_video" -var "cp_addr"
public_flat_rw -module "vh_video" -var "spr_addr"
// the same for e1_pipe (+define+E1_PIPE)
public_flat_rw -module "e1_pipe" -var "G"
public_flat_rw -module "e1_pipe" -var "sr"
public_flat_rw -module "e1_pipe" -var "state"
public_flat_rw -module "e1_pipe" -var "op"
public_flat_rw -module "e1_pipe" -var "e1"
public_flat_rw -module "e1_pipe" -var "ipc"
// +prof: where a line fill's clocks go
public_flat_rw -module "vh_cpumem" -var "m_who"
public_flat_rw -module "vh_cpumem" -var "line_req"
public_flat_rw -module "vh_cpumem" -var "f_ic"
public_flat_rw -module "sdram" -var "ram_req"
public_flat_rw -module "sdram" -var "state"
