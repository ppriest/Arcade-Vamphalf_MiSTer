<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME vamphalf.cpp; the layout is
         rtl/vh_sdram_map.svh. Do not edit by hand. -->
    <name>Vamf x1/2 (Europe, version 1.0.0903)</name>
    <setname>vamphalfr1</setname>
    <rbf>Vamphalf</rbf>
    <mameversion>0289</mameversion>
    <year>1999</year>
    <manufacturer>Danbi / F2 System</manufacturer>
    <category>Platform</category>
    <rotation>horizontal</rotation>
    <buttons names="Button 1,Button 2,Button 3,Button 4,Start,Coin,Pause,Service" default="A,B,X,Y,Start,Select,L,R" count="4"/>

    <!-- mod bytes (Vamphalf.sv): [0] E1-32 board, [2:1] rotation, [7:3] I/O map family;
         second byte [0] 16-bit sprite codes (gfx above 8 MB) -->
    <rom index="1"><part>10 00</part></rom>

    <rom index="0" zip="vamphalfr1.zip|vamphalf.zip" md5="none">
        <!-- maincpu -->
        <part repeat="0x80000">00</part>  <!-- maincpu 0x80000 -->
        <part name="ws1-01201.rom1" crc="afa75c19"/>
        <part repeat="0x80000">00</part>  <!-- eeprom -->
        <part repeat="0x80">FF</part>  <!-- eeprom: none in the set, the 93C46 erased -->
        <part repeat="0x7FF80">00</part>  <!-- samples -->
        <!-- oki1 samples -->
        <part name="ws1-01202.vrom1" crc="ee9e371e"/>
        <part repeat="0x5C0000">00</part>  <!-- gfx -->
        <!-- gfx: ROM_LOAD32_WORD pairs -->
        <interleave output="32">
            <part name="elc.roml01" crc="19df4056" map="0021"/>
            <part name="evi.romu01" crc="f9803923" map="2100"/>
        </interleave>
    </rom>

    <nvram index="2" size="128"/>
</misterromdescription>
